# =============================================================================
# report_competitor_monitor — environment template
# Copy to `environment.env` and fill in the real values.
# NEVER commit environment.env (it is git-ignored).
# =============================================================================

# --- DeepSeek LLM -----------------------------------------------------------
DEEPSEEK_API_KEY=sk-your-deepseek-api-key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# Report narrative temperature (higher = more expressive) and analyzer (stable).
LLM_TEMPERATURE_REPORT=0.6
LLM_TEMPERATURE_ANALYZER=0.1
LLM_TIMEOUT=60
LLM_MAX_RETRIES=3

# --- Lark / Feishu bots (two separate group-bot webhooks) -------------------
# Weekly/data-report bot:
LARK_WEBHOOK_WEEKLY=https://open.larksuite.com/open-apis/bot/v2/hook/REPLACE_WEEKLY
# Competitor-monitor bot:
LARK_WEBHOOK_COMPETITOR=https://open.larksuite.com/open-apis/bot/v2/hook/REPLACE_COMPETITOR
LARK_ENABLED=true

# --- Gmail (OAuth desktop client) -------------------------------------------
# Create an OAuth "Desktop app" credential in Google Cloud Console, download the
# JSON to credentials/client_secret.json. The first run opens a browser to mint
# credentials/token.json; afterwards it refreshes silently (server-friendly).
GMAIL_CLIENT_SECRET_FILE=credentials/client_secret.json
GMAIL_TOKEN_FILE=credentials/token.json
GMAIL_SENDER=your-account@gmail.com
GMAIL_RECIPIENTS=dingbangchu@gmail.com
GMAIL_ENABLED=true

# --- Reports / storage ------------------------------------------------------
REPORTS_DIR=reports
DB_PATH=data/report_monitor.db
# Public base URL where reports/ is served (used for Lark card buttons).
# Leave blank to point buttons at the local absolute file path.
REPORT_BASE_URL=

# --- macOS notifications ----------------------------------------------------
ENABLE_MAC_NOTIFY=true
